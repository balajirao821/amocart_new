# AmoCart Django Environment Configuration Example
# Copy to .env and configure local values

# Django Core
SECRET_KEY=django-insecure-amocart-production-crypto-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# MySQL Database Configuration
DB_NAME=amocart_db
DB_USER=amocart_user
DB_PASSWORD=StrongAmoCartPass2026!
DB_HOST=127.0.0.1
DB_PORT=3306

# Razorpay Payment Gateway Credentials (Test Sandbox)
RAZORPAY_KEY_ID=rzp_test_AMOCART_DEMO_2026
RAZORPAY_KEY_SECRET=amocart_secret_key_prod_verified_9941
RAZORPAY_WEBHOOK_SECRET=amocart_webhook_secret_hmac_2026

# Email SMTP Notification Backend (Development: console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=support@amocart.com
EMAIL_HOST_PASSWORD=placeholder-app-password
DEFAULT_FROM_EMAIL=AmoCart Notifications <no-reply@amocart.com>
